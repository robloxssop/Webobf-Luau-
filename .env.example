# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for self-referential links
APP_URL="MY_APP_URL"

# Server & Security Configuration
PORT=3000
NODE_ENV="development"
ADMIN_ROUTE_SLUG="sys-console-sec-ops"
JWT_SECRET="aegis_jwt_signing_secret_min_32_characters_length_secure"
VAULT_MASTER_KEY="aegis_aes256gcm_vault_master_key_32_bytes_len!"

